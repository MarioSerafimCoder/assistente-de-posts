# A aplicação funciona sem nenhuma das variáveis abaixo.
# Nenhuma integração é necessária para a geração básica de posts.

# IA local opcional (LM Studio ou servidor OpenAI-compatible)
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_AI_MODEL=

# OpenAI opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_MODEL=

# Banco externo de imagens opcional
PEXELS_API_KEY=
